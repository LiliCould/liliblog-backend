<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.lilicould</groupId>
        <artifactId>liliblog</artifactId>
        <version>2.0.2</version>
    </parent>

    <artifactId>liliblog-service</artifactId>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cn.lilicould</groupId>
            <artifactId>liliblog-common</artifactId>
            <version>2.0.2</version>
        </dependency>

        <dependency>
            <groupId>cn.lilicould</groupId>
            <artifactId>liliblog-pojo</artifactId>
            <version>2.0.2</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 排除不需要的依赖 -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                        <!-- 排除 nextdoc4j UI 及 openapi UI 前端（生产不需要） -->
                        <exclude>
                            <groupId>top.nextdoc4j</groupId>
                            <artifactId>nextdoc4j-ui</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>top.nextdoc4j</groupId>
                            <artifactId>nextdoc4j-springboot4-starter</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>top.nextdoc4j</groupId>
                            <artifactId>nextdoc4j-common-springboot4</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>top.nextdoc4j</groupId>
                            <artifactId>nextdoc4j-core</artifactId>
                        </exclude>
                        <!-- swagger-ui 前端页面，生产不需要 -->
                        <exclude>
                            <groupId>org.webjars</groupId>
                            <artifactId>swagger-ui</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>org.webjars</groupId>
                            <artifactId>webjars-locator-lite</artifactId>
                        </exclude>
                        <!-- springdoc webmvc-ui 入口，生产不需要 -->
                        <exclude>
                            <groupId>org.springdoc</groupId>
                            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                        </exclude>
                        <!-- 排除 hutool-core (nextdoc4j 传递依赖，未直接使用) -->
                        <exclude>
                            <groupId>cn.hutool</groupId>
                            <artifactId>hutool-core</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>